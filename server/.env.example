# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For Cloud PostgreSQL (Supabase / Neon / Render):
# DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edupulse_db?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-edupulse-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin
CLIENT_URL="http://localhost:5173"
